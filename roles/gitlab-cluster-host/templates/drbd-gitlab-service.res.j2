resource drbd-gitlab-service {

	volume 0{
		device /dev/drbd0;
		disk /dev/vg_{{ vg_drbd }}/lv_{{ lv_drbd }};
		meta-disk internal;
	}
		
	net{
		protocol C;
	}
		
	connection-mesh{
		hosts {{ groups['gitlab_cluster']|list|regex_replace('[\],\[\']', '') }};
	}

{% set ns = namespace(counter = 0) %}
{% for drbd_host in groups['gitlab_cluster'] %}
	on {{ drbd_host }}{
		address {{ hostvars[drbd_host]['ansible_host'] }}:7788;
		node-id {{ ns.counter }};
	}
{% set ns.counter = ns.counter + 1 %}
{% endfor %}

}

